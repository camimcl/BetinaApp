# API-Football (grátis em: https://dashboard.api-football.com/register)
FOOTBALL_API_KEY=<sua_chave_api_football>

# Google Gemini (AI Studio) — grátis em: https://aistudio.google.com/apikey
GEMINI_API_KEY=<seu_token>
GEMINI_MODEL=gemini-2.5-flash

# Ambiente
ENV=development

# Caminhos de dados (não precisa alterar)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=data/models
